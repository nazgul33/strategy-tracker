DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
APP_PASSWORD=
SESSION_SECRET=
DIGEST_LANG=en

# --- docker compose deployment only (the app itself just reads DATABASE_URL) ---
# compose creates this database + dedicated account on first DB init and points
# the app's DATABASE_URL at it; MARIADB_ROOT_PASSWORD is for the image bootstrap
# and manual admin, never for the app. MARIADB_USER defaults to st_app,
# MARIADB_DATABASE to st_db.
MARIADB_HOST=db
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=st_db
MARIADB_USER=st_app
MARIADB_PASSWORD=
# port binding for the app container: unset/empty ⇒ 127.0.0.1 (local only);
# set 0.0.0.0 to listen on all interfaces in production
APP_BIND_HOST=
