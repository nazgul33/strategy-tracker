{
  "name": "strategy-tracker",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "echo 'no root dev script — run: bun run --cwd apps/server dev  ·  bun run --cwd apps/web dev' && exit 1",
    "typecheck": "tsc -b && tsc -p apps/web --noEmit && tsc -p scripts --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "bun-types": "^1.4.4",
    "typescript": "^5.6.0"
  }
}
